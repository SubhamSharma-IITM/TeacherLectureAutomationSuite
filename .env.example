# ── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ── Whisper settings ─────────────────────────────
WHISPER_MODEL=whisper-1

# ── Upload limits ────────────────────────────────
MAX_FILE_SIZE_MB=100

# ── Language default ─────────────────────────────
# Options: auto | hi | en
LANGUAGE_HINT=auto

# ── Frontend (set in .env.local for Vite) ────────
VITE_API_URL=http://localhost:8000
