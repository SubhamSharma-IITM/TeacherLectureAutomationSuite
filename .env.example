# ── OpenAI ───────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Whisper ──────────────────────────────────────
WHISPER_MODEL=whisper-1

# ── Upload limits ────────────────────────────────
MAX_FILE_SIZE_MB=100

# ── Language default (used as server-side fallback)
# Options: auto | hi | en
LANGUAGE_HINT=auto

# ── Fonts ────────────────────────────────────────
# Path to NotoSansDevanagari-Regular.ttf for PDF export
# Download: https://fonts.google.com/noto/specimen/Noto+Sans+Devanagari
DEVANAGARI_FONT_PATH=NotoSansDevanagari-Regular.ttf

# ── CORS ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (required when scaling beyond single worker) ──
REDIS_URL=redis://localhost:6379/0

# ── Frontend (Vite) ──────────────────────────────
VITE_API_URL=http://localhost:8000
